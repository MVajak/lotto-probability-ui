{
  "name": "lotto-probability",
  "version": "1.0.0",
  "private": true,
  "description": "Lotto Probability Monorepo",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lotto/app dev",
    "build": "pnpm --filter @lotto/app build",
    "preview": "pnpm --filter @lotto/app preview",
    "storybook": "pnpm --filter @lotto/storybook storybook",
    "build-storybook": "pnpm --filter @lotto/storybook build-storybook",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "typescript": "^5.9.3"
  }
}
